-- Hent alle ambulanser
getAllAmbulances:
SELECT *
FROM Ambulance;

-- Hent daglig sjekkliste (template.type = 'daily')
getDailyChecklistTemplate:
SELECT *
FROM ChecklistTemplate
WHERE type = 'daily'
LIMIT 1;

-- Hent alle items for en template
getChecklistItemsByTemplateId:
SELECT *
FROM ChecklistItem
WHERE templateId = ?1
ORDER BY sortOrder;

-- Opprett en ny checklist run
insertChecklistRun:
INSERT INTO ChecklistRun(
  id, templateId, ambulanceId, userId,
  createdAt, completedAt, status, synced
)
VALUES (?1, ?2, ?3, ?4, ?5, NULL, 'INCOMPLETE', 0);

-- Oppdater run til completed
completeChecklistRun:
UPDATE ChecklistRun
SET completedAt = ?2,
    status = 'completed'
WHERE id = ?1;

-- Sett response for et item
insertChecklistResponse:
INSERT INTO ChecklistResponse(
  id, checklistRunId, itemId, result, comment, checkedAt
)
VALUES (?1, ?2, ?3, ?4, ?5, ?6);

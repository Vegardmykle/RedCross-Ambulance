CREATE TABLE ChecklistResponse (
    id TEXT NOT NULL PRIMARY KEY,
    checklistRunId TEXT NOT NULL,
    itemId TEXT NOT NULL,
    result TEXT NOT NULL CHECK (result IN ('JA','NEI','MANGELFULL','ODELAGT')),
    comment TEXT,
    reading TEXT, -- avlest verdi der punktet krever det (f.eks. '180' bar)
    checkedAt INTEGER NOT NULL,
    resolved INTEGER NOT NULL DEFAULT 0, -- 1 når avviket er fulgt opp
    resolvedAt INTEGER, -- når avviket ble markert som løst
    resolvedReading TEXT, -- ny avlest verdi ved løsing (gammel ligger i reading)
    resolvedVia TEXT CHECK (resolvedVia IN ('MANUAL','RECHECK','SUPERSEDED')), -- manuelt / OK ved senere kontroll / erstattet av nytt avvik
    resolvedByRunId TEXT, -- kjøringen som lukket avviket (for angring)
    resolvedByUserId TEXT, -- mannskaps-ID som signerte manuell løsing
    updatedAt INTEGER NOT NULL DEFAULT 0, -- sync: sist endret lokalt
    synced INTEGER NOT NULL DEFAULT 0, -- 0 = har usynkede lokale endringer

    FOREIGN KEY (resolvedByUserId)
        REFERENCES User(id),

    UNIQUE (checklistRunId, itemId),

    FOREIGN KEY (checklistRunId)
        REFERENCES ChecklistRun(id),

    FOREIGN KEY (itemId)
        REFERENCES ChecklistItem(id)
);

upsertResponse:
INSERT OR REPLACE INTO ChecklistResponse(id, checklistRunId, itemId, result, comment, reading, checkedAt, resolved, resolvedAt, resolvedReading, resolvedVia, resolvedByRunId, resolvedByUserId, updatedAt, synced)
VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, 0, NULL, NULL, NULL, NULL, NULL, ?7, 0);

getResponseById:
SELECT *
FROM ChecklistResponse
WHERE id = ?1;

getResponsesForRun:
SELECT *
FROM ChecklistResponse
WHERE checklistRunId = ?1;

-- Til arkivet: alle svar i en kjøring med punkttittel og hvilken liste/sekk de hører til
getResponsesWithItemsForRun:
SELECT
    ChecklistResponse.*,
    ChecklistItem.title AS itemTitle,
    ChecklistItem.unit,
    ChecklistTemplate.name AS listName,
    ChecklistTemplate.parentId,
    ResolvedUser.name AS resolvedByName
FROM ChecklistResponse
JOIN ChecklistItem ON ChecklistItem.id = ChecklistResponse.itemId
JOIN ChecklistTemplate ON ChecklistTemplate.id = ChecklistItem.templateId
LEFT JOIN User AS ResolvedUser ON ResolvedUser.id = ChecklistResponse.resolvedByUserId
WHERE checklistRunId = ?1
ORDER BY ChecklistTemplate.parentId IS NOT NULL, ChecklistTemplate.name, ChecklistItem.sortOrder;

countResponsesForRun:
SELECT COUNT(*)
FROM ChecklistResponse
WHERE checklistRunId = ?1;

getOpenDeficiencies:
SELECT
    ChecklistResponse.id,
    ChecklistResponse.itemId,
    ChecklistResponse.checklistRunId,
    ChecklistResponse.result,
    ChecklistResponse.comment,
    ChecklistResponse.reading,
    ChecklistResponse.checkedAt,
    ChecklistItem.title AS itemTitle,
    ChecklistItem.requiresValue,
    ChecklistItem.unit,
    ChecklistItem.minValue,
    ChecklistItem.maxValue,
    ChecklistTemplate.name AS listName,
    Ambulance.callSign,
    ChecklistRun.userId,
    User.name AS signedByName
FROM ChecklistResponse
JOIN ChecklistItem ON ChecklistItem.id = ChecklistResponse.itemId
JOIN ChecklistTemplate ON ChecklistTemplate.id = ChecklistItem.templateId
JOIN ChecklistRun ON ChecklistRun.id = ChecklistResponse.checklistRunId
JOIN Ambulance ON Ambulance.id = ChecklistRun.ambulanceId
LEFT JOIN User ON User.id = ChecklistRun.userId
WHERE ChecklistResponse.result IN ('NEI','MANGELFULL','ODELAGT')
  AND ChecklistResponse.resolved = 0
ORDER BY ChecklistResponse.checkedAt DESC;

resolveDeficiency:
UPDATE ChecklistResponse
SET resolved = 1, resolvedAt = ?2, resolvedReading = ?3, resolvedVia = 'MANUAL', resolvedByUserId = ?4, updatedAt = ?2, synced = 0
WHERE id = ?1;

-- Lukk tidligere åpne avvik på samme punkt/ambulanse fra en senere kontroll.
-- ?5 = 'RECHECK' (punktet er OK nå) eller 'SUPERSEDED' (nytt avvik erstatter det gamle)
resolveEarlierDeficiencies:
UPDATE ChecklistResponse
SET resolved = 1, resolvedAt = ?3, resolvedReading = ?4, resolvedVia = ?5, resolvedByRunId = ?2, updatedAt = ?3, synced = 0
WHERE itemId = ?1
  AND resolved = 0
  AND result != 'JA'
  AND checklistRunId != ?2
  AND checklistRunId IN (
      SELECT id FROM ChecklistRun
      WHERE ambulanceId = (SELECT ambulanceId FROM ChecklistRun WHERE id = ?2)
  );

-- Forgjengeren i en videreført-kjede: avviket som ble erstattet av kjøringen ?2
getSupersededPredecessor:
SELECT ChecklistResponse.checkedAt, ChecklistResponse.checklistRunId, User.name AS signedByName
FROM ChecklistResponse
JOIN ChecklistRun ON ChecklistRun.id = ChecklistResponse.checklistRunId
LEFT JOIN User ON User.id = ChecklistRun.userId
WHERE ChecklistResponse.itemId = ?1
  AND ChecklistResponse.resolvedByRunId = ?2
  AND ChecklistResponse.resolvedVia = 'SUPERSEDED'
LIMIT 1;

-- Angring: hvis svaret i gjeldende kjøring endres, nullstill lukkinger denne kjøringen forårsaket
undoResolutionsByRun:
UPDATE ChecklistResponse
SET resolved = 0, resolvedAt = NULL, resolvedReading = NULL, resolvedVia = NULL, resolvedByRunId = NULL, updatedAt = ?3, synced = 0
WHERE itemId = ?1
  AND resolvedByRunId = ?2;

-- Punkter med åpne avvik fra tidligere kontroller (samme ambulanse, ikke gjeldende kjøring)
getItemIdsWithOpenDeficiencies:
SELECT DISTINCT ChecklistResponse.itemId
FROM ChecklistResponse
JOIN ChecklistRun ON ChecklistRun.id = ChecklistResponse.checklistRunId
WHERE ChecklistRun.ambulanceId = ?1
  AND ChecklistResponse.checklistRunId != ?2
  AND ChecklistResponse.resolved = 0
  AND ChecklistResponse.result != 'JA';

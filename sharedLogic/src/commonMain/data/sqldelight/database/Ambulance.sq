CREATE TABLE Ambulance (
    id TEXT NOT NULL PRIMARY KEY,
    callSign TEXT NOT NULL,
    registrationNumber TEXT NOT NULL
);

getAllAmbulances:
SELECT *
FROM Ambulance
ORDER BY callSign;

insertAmbulance:
INSERT INTO Ambulance(id, callSign, registrationNumber)
VALUES (?1, ?2, ?3);

deleteAmbulance:
DELETE FROM Ambulance
WHERE id = ?1;

countAmbulances:
SELECT COUNT(*)
FROM Ambulance;

CREATE TABLE ChecklistRun (
    id TEXT NOT NULL PRIMARY KEY,
    templateId TEXT NOT NULL,
    ambulanceId TEXT NOT NULL,
    userId TEXT, -- mannskaps-ID (User.id), settes ved signering/lukking
    createdAt INTEGER NOT NULL,
    completedAt INTEGER,
    status TEXT NOT NULL CHECK (status IN ('IN_PROGRESS','COMPLETED','EXPIRED')),
    comment TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- sync: sist endret lokalt
    synced INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY (templateId)
        REFERENCES ChecklistTemplate(id),

    FOREIGN KEY (ambulanceId)
        REFERENCES Ambulance(id),

    FOREIGN KEY (userId)
        REFERENCES User(id)
);

insertRun:
INSERT INTO ChecklistRun(id, templateId, ambulanceId, userId, createdAt, completedAt, status, comment, updatedAt, synced)
VALUES (?1, ?2, ?3, NULL, ?4, NULL, 'IN_PROGRESS', NULL, ?4, 0);

getOpenRun:
SELECT *
FROM ChecklistRun
WHERE templateId = ?1 AND ambulanceId = ?2 AND status = 'IN_PROGRESS'
ORDER BY createdAt DESC
LIMIT 1;

getRunById:
SELECT *
FROM ChecklistRun
WHERE id = ?1;

completeRun:
UPDATE ChecklistRun
SET status = 'COMPLETED', completedAt = ?2, userId = ?3, comment = ?4, updatedAt = ?2, synced = 0
WHERE id = ?1;

-- Usignert kjøring fra en tidligere dag: bevares, men merkes utløpt
expireRun:
UPDATE ChecklistRun
SET status = 'EXPIRED', updatedAt = ?2, synced = 0
WHERE id = ?1;

getRecentRuns:
SELECT ChecklistRun.*, ChecklistTemplate.name AS templateName, Ambulance.callSign, User.name AS signedByName,
    (SELECT COUNT(*)
     FROM ChecklistResponse
     WHERE ChecklistResponse.checklistRunId = ChecklistRun.id
       AND ChecklistResponse.result != 'JA') AS deviationCount,
    (SELECT COUNT(*)
     FROM ChecklistResponse
     WHERE ChecklistResponse.checklistRunId = ChecklistRun.id
       AND ChecklistResponse.result != 'JA'
       AND ChecklistResponse.resolved = 1
       AND ChecklistResponse.resolvedVia != 'SUPERSEDED') AS resolvedCount,
    (SELECT COUNT(*)
     FROM ChecklistResponse
     WHERE ChecklistResponse.checklistRunId = ChecklistRun.id
       AND ChecklistResponse.result != 'JA'
       AND ChecklistResponse.resolvedVia = 'SUPERSEDED') AS supersededCount
FROM ChecklistRun
JOIN ChecklistTemplate ON ChecklistTemplate.id = ChecklistRun.templateId
JOIN Ambulance ON Ambulance.id = ChecklistRun.ambulanceId
LEFT JOIN User ON User.id = ChecklistRun.userId
ORDER BY createdAt DESC
LIMIT ?1;

deleteRun:
DELETE FROM ChecklistRun
WHERE id = ?1;

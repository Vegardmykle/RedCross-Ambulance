CREATE TABLE ChecklistResponse (
    id TEXT NOT NULL PRIMARY KEY,
    checklistRunId TEXT NOT NULL,
    itemId TEXT NOT NULL,
    result TEXT NOT NULL CHECK (result IN ('JA','NEI','MANGELFULL','ODELAGT')),
    comment TEXT,
    reading TEXT, -- avlest verdi der punktet krever det (f.eks. '180' bar)
    checkedAt INTEGER NOT NULL,
    resolved INTEGER NOT NULL DEFAULT 0, -- 1 når avviket er fulgt opp

    UNIQUE (checklistRunId, itemId),

    FOREIGN KEY (checklistRunId)
        REFERENCES ChecklistRun(id),

    FOREIGN KEY (itemId)
        REFERENCES ChecklistItem(id)
);

upsertResponse:
INSERT OR REPLACE INTO ChecklistResponse(id, checklistRunId, itemId, result, comment, reading, checkedAt, resolved)
VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, 0);

getResponsesForRun:
SELECT *
FROM ChecklistResponse
WHERE checklistRunId = ?1;

countResponsesForRun:
SELECT COUNT(*)
FROM ChecklistResponse
WHERE checklistRunId = ?1;

getOpenDeficiencies:
SELECT
    ChecklistResponse.id,
    ChecklistResponse.result,
    ChecklistResponse.comment,
    ChecklistResponse.reading,
    ChecklistResponse.checkedAt,
    ChecklistItem.title AS itemTitle,
    ChecklistTemplate.name AS listName,
    Ambulance.callSign,
    ChecklistRun.userId,
    User.name AS signedByName
FROM ChecklistResponse
JOIN ChecklistItem ON ChecklistItem.id = ChecklistResponse.itemId
JOIN ChecklistTemplate ON ChecklistTemplate.id = ChecklistItem.templateId
JOIN ChecklistRun ON ChecklistRun.id = ChecklistResponse.checklistRunId
JOIN Ambulance ON Ambulance.id = ChecklistRun.ambulanceId
LEFT JOIN User ON User.id = ChecklistRun.userId
WHERE ChecklistResponse.result IN ('NEI','MANGELFULL','ODELAGT')
  AND ChecklistResponse.resolved = 0
ORDER BY ChecklistResponse.checkedAt DESC;

resolveDeficiency:
UPDATE ChecklistResponse
SET resolved = 1
WHERE id = ?1;

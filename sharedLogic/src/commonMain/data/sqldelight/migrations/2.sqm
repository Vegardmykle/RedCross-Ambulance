-- Versjon 2 → 3: retter kolonnerekkefølgen etter 1.sqm.
--
-- 1.sqm la til phase, beforeSignedAt og beforeUserId med ALTER TABLE ADD
-- COLUMN. SQLite legger alltid nye kolonner sist, mens .sq-filene har dem
-- midt i tabellen. En database som er MIGRERT får derfor en annen fysisk
-- kolonnerekkefølge enn en som er opprettet FERSK fra .sq.
--
-- Det er ikke kosmetikk. SQLDelight genererer mappere som leser posisjonelt
-- (cursor.getString(9) for phase), så på en migrert database leses feil
-- kolonne:
--
--   ChecklistItem.phase     <- updatedAt   (etter-punkter vises som før-punkter)
--   ChecklistItem.deleted   <- synced      (synkede punkter tolkes som slettet)
--   ChecklistRun.beforeSignedAt <- updatedAt  (alt ser før-signert ut)
--   ChecklistRun.updatedAt  <- beforeSignedAt, som er NULL for eldre rader
--                              -> getLong(...)!! kaster NullPointerException
--
-- Ingen enhet har oppdaget dette ennå fordi alle installasjoner så langt har
-- vært ferske. Enheten i drift står fortsatt på skjemaversjon 1 og ville
-- truffet krasjet første gang den ble oppdatert.
--
-- Rettingen bygger tabellene om. INSERT ... SELECT bruker eksplisitte
-- kolonnenavn, ikke posisjon, så den gir samme resultat enten kilden er en
-- migrert eller en fersk database. Dataene i basen er riktige – det er bare
-- lesingen som har vært feil – så ingenting går tapt.
--
-- Indeksene er det ingen av, og fremmednøkler håndheves ikke av driverne
-- (SQLite har PRAGMA foreign_keys av som standard), så DROP + RENAME er
-- trygt her.

CREATE TABLE ChecklistItem_rebuilt (
    id TEXT NOT NULL PRIMARY KEY,
    templateId TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT,
    requiresValue INTEGER NOT NULL DEFAULT 0,
    unit TEXT,
    minValue REAL,
    maxValue REAL,
    sortOrder INTEGER NOT NULL,
    phase TEXT NOT NULL DEFAULT 'BEFORE',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER NOT NULL DEFAULT 0,
    synced INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY (templateId)
        REFERENCES ChecklistTemplate(id)
);

INSERT INTO ChecklistItem_rebuilt (
    id, templateId, title, description, requiresValue, unit, minValue,
    maxValue, sortOrder, phase, updatedAt, deleted, synced
)
SELECT
    id, templateId, title, description, requiresValue, unit, minValue,
    maxValue, sortOrder, phase, updatedAt, deleted, synced
FROM ChecklistItem;

DROP TABLE ChecklistItem;

ALTER TABLE ChecklistItem_rebuilt RENAME TO ChecklistItem;

CREATE TABLE ChecklistRun_rebuilt (
    id TEXT NOT NULL PRIMARY KEY,
    templateId TEXT NOT NULL,
    ambulanceId TEXT NOT NULL,
    userId TEXT,
    createdAt INTEGER NOT NULL,
    completedAt INTEGER,
    status TEXT NOT NULL CHECK (status IN ('IN_PROGRESS','COMPLETED','EXPIRED')),
    comment TEXT,
    beforeSignedAt INTEGER,
    beforeUserId TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    synced INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY (templateId)
        REFERENCES ChecklistTemplate(id),

    FOREIGN KEY (ambulanceId)
        REFERENCES Ambulance(id),

    FOREIGN KEY (userId)
        REFERENCES User(id)
);

INSERT INTO ChecklistRun_rebuilt (
    id, templateId, ambulanceId, userId, createdAt, completedAt, status,
    comment, beforeSignedAt, beforeUserId, updatedAt, synced
)
SELECT
    id, templateId, ambulanceId, userId, createdAt, completedAt, status,
    comment, beforeSignedAt, beforeUserId, updatedAt, synced
FROM ChecklistRun;

DROP TABLE ChecklistRun;

ALTER TABLE ChecklistRun_rebuilt RENAME TO ChecklistRun;

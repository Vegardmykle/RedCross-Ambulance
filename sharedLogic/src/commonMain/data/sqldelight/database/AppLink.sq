-- Lenker til eksterne skjema (avviksmelding, naloxon-registrering, medisinutdeling osv.)
CREATE TABLE AppLink (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    url TEXT NOT NULL,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- sync: sist endret lokalt
    deleted INTEGER NOT NULL DEFAULT 0, -- soft delete: synkes som tombstone
    synced INTEGER NOT NULL DEFAULT 0 -- 0 = har usynkede lokale endringer
);

getAllLinks:
SELECT *
FROM AppLink
WHERE deleted = 0
ORDER BY sortOrder;

insertLink:
INSERT INTO AppLink(id, title, url, sortOrder, updatedAt, deleted, synced)
VALUES (?1, ?2, ?3, ?4, ?5, 0, 0);

updateLink:
UPDATE AppLink
SET title = ?2, url = ?3, updatedAt = ?4, synced = 0
WHERE id = ?1;

deleteLink:
UPDATE AppLink
SET deleted = 1, updatedAt = ?2, synced = 0
WHERE id = ?1;

countLinks:
SELECT COUNT(*)
FROM AppLink
WHERE deleted = 0;

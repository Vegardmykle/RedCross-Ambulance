-- Interne instrukser, beredskapsplan, tiltakskort (PDF) – lagres som lokal filsti
CREATE TABLE Document (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    uri TEXT NOT NULL, -- lokal filsti
    sortOrder INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- sync: sist endret lokalt
    deleted INTEGER NOT NULL DEFAULT 0, -- soft delete: synkes som tombstone
    synced INTEGER NOT NULL DEFAULT 0 -- 0 = har usynkede lokale endringer
);

getAllDocuments:
SELECT *
FROM Document
WHERE deleted = 0
ORDER BY sortOrder;

insertDocument:
INSERT INTO Document(id, title, uri, sortOrder, updatedAt, deleted, synced)
VALUES (?1, ?2, ?3, ?4, ?5, 0, 0);

updateDocument:
UPDATE Document
SET title = ?2, uri = ?3, updatedAt = ?4, synced = 0
WHERE id = ?1;

deleteDocument:
UPDATE Document
SET deleted = 1, updatedAt = ?2, synced = 0
WHERE id = ?1;
